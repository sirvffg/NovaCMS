<h1>🔍 文章下载流程调试</h1>
<h2>文章: <?= htmlspecialchars($post['title']) ?> (ID: <?= $postId ?>)</h2>
<p class="log-info">页面加载完成 - <?= date('H:i:s') ?></p>

<div id="tempDirCheck" class="step">📁 检查 temp 目录... <span class="log-info">检查中</span></div>
<div id="linkAnalysis" class="step pending">📝 分析文章资源链接... <span class="log-info">等待</span></div>
<div id="progressSection" class="step pending" style="display:none;">
  📋 复制资源文件
  <div class="progress-bar"><div id="progressFill" class="progress-fill" style="width:0%">0%</div></div>
  <div id="copyLog" class="log-container"></div>
</div>
<div id="zipSection" class="step pending" style="display:none;">📦 生成 ZIP 文件... <span class="log-info">等待</span></div>
<div id="resultSection" class="step pending" style="display:none;">🎯 最终结果... <span class="log-info">等待</span></div>

<div id="actions" style="margin: 20px 0; text-align: center;">
  <button id="btnStart" class="btn btn-primary" onclick="startProcess()">▶ 开始生成压缩包</button>
  <button id="btnCleanup" class="btn btn-danger" style="display:none;" onclick="cleanup()">🗑 清理临时文件</button>
  <button id="btnDownload" class="btn btn-primary" style="display:none;" onclick="downloadZip()">📥 下载 ZIP 文件</button>
</div>

<script>
const postId = <?= $postId ?>;
let uniqueId = '';
let replacedUrls = {}; // url => filename

// 页面加载后检查 temp 目录并分析链接
window.onload = function() {
    checkTempDir();
};

function log(elementId, msg, type = 'info') {
    const el = document.getElementById(elementId);
    if (el) {
        const cls = type === 'success' ? 'log-success' : type === 'error' ? 'log-error' : 'log-warning';
        el.innerHTML += '<div class="' + cls + '">' + msg + '</div>';
    }
}

function updateStep(id, status, content) {
    const el = document.getElementById(id);
    if (!el) return;
    el.className = 'step ' + status;
    if (content) el.innerHTML = content;
}

function checkTempDir() {
    const el = document.getElementById('tempDirCheck');
    el.className = 'step running';
    
    fetch('?id=' + postId + '&action=prepare')
        .then(r => r.json())
        .then(data => {
            if (!data.success) {
                updateStep('tempDirCheck', 'error', '📁 检查 temp 目录 <span class="log-error">✗ ' + data.error + '</span>');
                return;
            }
            uniqueId = data.uniqueId;
            
            let localHtml = '<strong>📦 本地资源 (需打包 ' + data.localUrls.length + ' 个)</strong><div class="url-list">';
            data.localUrls.forEach(u => { localHtml += '<div class="url-item url-local">✓ ' + htmlEscape(u) + '</div>'; });
            localHtml += '</div>';
            
            let extHtml = '';
            if (data.externalUrls.length > 0) {
                extHtml = '<strong>🌐 外部资源 (保持原链接 ' + data.externalUrls.length + ' 个)</strong><div class="url-list">';
                data.externalUrls.forEach(u => { extHtml += '<div class="url-item url-external">⚡ ' + htmlEscape(u) + '</div>'; });
                extHtml += '</div>';
            }
            
            let skipHtml = '';
            if (data.skippedUrls.length > 0) {
                skipHtml = '<strong>⏭ 已跳过 ' + data.skippedUrls.length + ' 个</strong><div class="url-list">';
                data.skippedUrls.forEach(s => { skipHtml += '<div class="url-item url-skipped">✗ ' + htmlEscape(s.url) + ' (' + s.reason + ')</div>'; });
                skipHtml += '</div>';
            }
            
            updateStep('tempDirCheck', 'success', '📁 检查 temp 目录 <span class="log-success">✓ 通过</span><br>临时目录: <code>' + data.tempDir + '</code>');
            updateStep('linkAnalysis', 'success', '📝 分析文章资源链接 <span class="log-success">✓ 完成</span><br>' + localHtml + extHtml + skipHtml);
            
            document.getElementById('btnStart').disabled = false;
        })
        .catch(err => {
            updateStep('tempDirCheck', 'error', '📁 检查 temp 目录 <span class="log-error">✗ ' + err.message + '</span>');
        });
}

function startProcess() {
    document.getElementById('btnStart').disabled = true;
    
    // 获取本地资源列表（从 session 中获取已有数据）
    fetch('?id=' + postId + '&action=start_copy')
        .then(r => r.json())
        .then(data => {
            if (!data.localUrls || data.localUrls.length === 0) {
                // 无本地资源，直接进入 ZIP 生成
                generateZip({});
                return;
            }
            
            // 显示进度条
            const progressSection = document.getElementById('progressSection');
            progressSection.style.display = 'block';
            progressSection.className = 'step running';
            
            const total = data.localUrls.length;
            let completed = 0;
            let failed = 0;
            
            // 逐个复制文件
            function copyNext(index) {
                if (index >= total) {
                    // 全部完成
                    progressSection.className = 'step success';
                    log('copyLog', '复制完成: 成功 ' + completed + ' 个, 失败 ' + failed + ' 个', 'success');
                    generateZip(replacedUrls);
                    return;
                }
                
                const url = data.localUrls[index];
                fetch('?id=' + postId + '&action=copy_file&url=' + encodeURIComponent(url))
                    .then(r => r.json())
                    .then(result => {
                        if (result.success) {
                            replacedUrls[result.url] = result.file;
                            log('copyLog', '✓ ' + result.file + ' (' + Math.round(result.size/1024) + ' KB)', 'success');
                            completed++;
                        } else {
                            log('copyLog', '✗ ' + (result.error || '失败') + ' - ' + url, 'error');
                            failed++;
                        }
                        const pct = Math.round(((completed + failed) / total) * 100);
                        document.getElementById('progressFill').style.width = pct + '%';
                        document.getElementById('progressFill').textContent = pct + '% (' + (completed + failed) + '/' + total + ')';
                        copyNext(index + 1);
                    })
                    .catch(err => {
                        log('copyLog', '✗ 网络错误 - ' + url, 'error');
                        failed++;
                        copyNext(index + 1);
                    });
            }
            
            copyNext(0);
        })
        .catch(err => {
            alert('准备失败: ' + err.message);
            document.getElementById('btnStart').disabled = false;
        });
}

function generateZip(replaced) {
    const zipSection = document.getElementById('zipSection');
    zipSection.style.display = 'block';
    zipSection.className = 'step running';
    zipSection.innerHTML = '📦 正在生成 ZIP 文件... <span class="log-info">处理中</span>';
    
    const formData = new FormData();
    formData.append('replaced_urls', JSON.stringify(replaced));
    
    fetch('?id=' + postId + '&action=generate_zip', {
        method: 'POST',
        body: formData
    })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                zipSection.className = 'step success';
                zipSection.innerHTML = '📦 ZIP 文件生成完成<br>' +
                    '- MD 文件: ' + data.mdFileSize + '<br>' +
                    '- 版权声明: ' + data.legalFileSize + '<br>' +
                    '- Assets: ' + data.assetsCount + ' 个文件<br>' +
                    '- ZIP 大小: ' + data.zipSize;
                
                const resultSection = document.getElementById('resultSection');
                resultSection.style.display = 'block';
                resultSection.className = 'step success';
                resultSection.innerHTML = '<strong style="font-size:18px;color:#28a745;">✓ ZIP 文件生成成功！</strong><br><br>';
                
                document.getElementById('btnDownload').style.display = 'inline-block';
                document.getElementById('btnDownload').onclick = function() {
                    window.location.href = 'temp/' + data.zipFile;
                };
                document.getElementById('btnCleanup').style.display = 'inline-block';
            } else {
                zipSection.className = 'step error';
                zipSection.innerHTML = '📦 ZIP 生成失败: <span class="log-error">' + data.error + '</span>';
                document.getElementById('btnStart').disabled = false;
            }
        })
        .catch(err => {
            zipSection.className = 'step error';
            zipSection.innerHTML = '📦 ZIP 生成失败: <span class="log-error">' + err.message + '</span>';
            document.getElementById('btnStart').disabled = false;
        });
}

function cleanup() {
    fetch('?id=' + postId + '&action=cleanup')
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                document.getElementById('btnCleanup').style.display = 'none';
                document.getElementById('btnDownload').style.display = 'none';
                document.getElementById('resultSection').innerHTML += '<br><span class="log-success">✓ 临时文件已清理</span>';
                document.getElementById('btnStart').disabled = false;
            }
        });
}

function htmlEscape(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
</script>
</body>
</html>